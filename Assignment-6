7. Find Right Interval

class Solution {
    public int[] findRightInterval(int[][] intervals) {

        int n = intervals.length;
        int[][] start = new int[n][2];

        for (int i = 0; i < n; i++) {
            start[i][0] = intervals[i][0];
            start[i][1] = i;
        }

        java.util.Arrays.sort(start, (a, b) -> a[0] - b[0]);

        int[] ans = new int[n];

        for (int i = 0; i < n; i++) {

            int target = intervals[i][1];
            int low = 0, high = n - 1;
            ans[i] = -1;

            while (low <= high) {

                int mid = low + (high - low) / 2;

                if (start[mid][0] >= target) {
                    ans[i] = start[mid][1];
                    high = mid - 1;
                } else {
                    low = mid + 1;
                }
            }
        }

        return ans;
    }
}


8. Reach a Number

class Solution {
    public int reachNumber(int target) {

        target = Math.abs(target);

        int sum = 0;
        int step = 0;

        while (sum < target || (sum - target) % 2 != 0) {
            step++;
            sum += step;
        }

        return step;
    }
}


9. Maximum Value at a Given Index in a Bounded Array

class Solution {

    public int maxValue(int n, int index, int maxSum) {

        int low = 1, high = maxSum;

        while (low < high) {

            int mid = (low + high + 1) / 2;

            if (check(n, index, maxSum, mid))
                low = mid;
            else
                high = mid - 1;
        }

        return low;
    }

    private boolean check(int n, int index, int maxSum, int val) {

        long left = calc(val - 1, index);
        long right = calc(val - 1, n - index - 1);

        return left + right + val <= maxSum;
    }

    private long calc(long peak, long len) {

        if (peak >= len)
            return (peak + peak - len + 1) * len / 2;

        return (peak + 1) * peak / 2 + (len - peak);
    }
}


