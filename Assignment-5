2. Concatenation of Array

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] nums = new int[n];
        int[] ans = new int[2 * n];

        for (int i = 0; i < n; i++)
            nums[i] = sc.nextInt();

        for (int i = 0; i < n; i++) {
            ans[i] = nums[i];
            ans[i + n] = nums[i];
        }

        System.out.println(Arrays.toString(ans));
    }
}


3. Running Sum of 1D Array

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] nums = new int[n];

        for (int i = 0; i < n; i++)
            nums[i] = sc.nextInt();

        for (int i = 1; i < n; i++)
            nums[i] += nums[i - 1];

        System.out.println(Arrays.toString(nums));
    }
}


4. Richest Customer Wealth

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int m = sc.nextInt();
        int n = sc.nextInt();

        int max = 0;

        for (int i = 0; i < m; i++) {
            int sum = 0;
            for (int j = 0; j < n; j++)
                sum += sc.nextInt();

            max = Math.max(max, sum);
        }

        System.out.println(max);
    }
}


5. Shuffle the Array

import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] nums = new int[2 * n];

        for (int i = 0; i < 2 * n; i++)
            nums[i] = sc.nextInt();

        int[] ans = new int[2 * n];

        int k = 0;

        for (int i = 0; i < n; i++) {
            ans[k++] = nums[i];
            ans[k++] = nums[i + n];
        }

        System.out.println(Arrays.toString(ans));
    }
}


6. Kids With the Greatest Number of Candies

import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] candies = new int[n];

        int max = 0;

        for (int i = 0; i < n; i++) {
            candies[i] = sc.nextInt();
            max = Math.max(max, candies[i]);
        }

        int extra = sc.nextInt();

        for (int i = 0; i < n; i++)
            System.out.print((candies[i] + extra >= max) + " ");
    }
}


7. Number of Good Pairs

